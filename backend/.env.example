# Backend reads this workspace-local .env file. The publishable key is safe
# for user-scoped requests when paired with the owner's verified access token.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
