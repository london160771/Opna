# Backend reads this workspace-local .env file. The publishable key is safe
# for user-scoped requests when paired with the owner's verified access token.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Backend only. Required for public business reads and booking writes that bypass RLS.
SUPABASE_SECRET_KEY=your-supabase-secret-key
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional bearer token used by the scheduled GitHub Actions database keepalive.
KEEPALIVE_TOKEN=replace-with-a-long-random-token
