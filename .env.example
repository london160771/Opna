# Optional repository-root fallback configuration. For local development, copy
# the separate frontend/.env.example and backend/.env.example files instead.
# Local Supabase values come from `npm run db:start`; publishable keys are public.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key
PORT=3001
CORS_ORIGINS=http://localhost:5173

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key
VITE_API_URL=/api
